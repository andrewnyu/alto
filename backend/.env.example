APP_NAME=ALTO API
APP_ENV=development
APP_VERSION=0.1.0
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
REQUEST_TIMEOUT_SECONDS=12

# Set to true to run with deterministic mock providers (no real Google API calls).
MOCK_MODE=false

# Google Maps stack
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAP_ID=
FAR_STREETVIEW_ENABLED=true
FAR_STREETVIEW_PROBE_RADIUS_M=120

# Google GenAI stack
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3
NANO_BANANA_MODEL=gemini-flash-image-3

# Optional base URL if app runs behind reverse proxy
PUBLIC_BASE_URL=
